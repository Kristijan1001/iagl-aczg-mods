	</variable>
	
	<variable name="SDR_Final_Output_Var">
		
		
		<value condition="String.Contains(Control.GetLabel(66602),SDR) + String.IsEqual(VideoPlayer.HdrType,hdr10) + !String.IsEmpty(Player.Process(video.source.hdr.type)) + String.IsEqual(Player.Process(video.source.hdr.type),Control.GetLabel(66601))"></value>
		
		
		<value condition="Integer.IsEqual(Player.Process(amlogic.vs10.mode.raw),3) + [String.IsEqual(VideoPlayer.HdrType,dolbyvision) + !String.IsEmpty(Player.Process(video.source.hdr.type)) + String.IsEqual(Player.Process(video.source.hdr.type),Control.GetLabel(66601))]">➜ SDR</value>
