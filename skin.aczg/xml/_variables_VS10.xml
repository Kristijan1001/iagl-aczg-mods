	<variable name="Video_HDR_Codec">
		
		<!-- HLG -->
		<value condition="String.Contains(Player.Process(video.source.hdr.type),HLG)">HLG</value>
		
		<value condition="String.IsEqual(VideoPlayer.HdrType,dolbyvision) + !String.IsEmpty(Player.Process(video.source.hdr.type)) + String.IsEqual(Player.Process(video.source.hdr.type),Control.GetLabel(66601))">HDR10+</value>
		<value condition="String.IsEqual(VideoPlayer.HdrType,dolbyvision)">Dolby Vision</value>
		<value condition="String.IsEqual(VideoPlayer.HdrType,hdr10) + !String.IsEmpty(Player.Process(video.source.hdr.type)) + String.IsEqual(Player.Process(video.source.hdr.type),Control.GetLabel(66601))">HDR10+</value>
		<!--<value condition="String.IsEqual(VideoPlayer.HdrType,hdr10) + String.Contains(Player.Process(video.source.hdr.type),HDR10+)">HDR10+</value>-->
		<value condition="String.IsEqual(VideoPlayer.HdrType,hdr10)">HDR10</value>
		<value condition="String.IsEqual(VideoPlayer.HdrType,hdr10plus)">HDR10+</value>
		<value condition="String.IsEqual(VideoPlayer.HdrType,hlg)">HLG</value>
		<value>SDR</value>
	</variable>
	<variable name="Video_HDR_Codec_Short">
		
		<!-- HLG -->
		<value condition="String.Contains(Player.Process(video.source.hdr.type),HLG)">HLG</value>
		
		<value condition="String.IsEqual(VideoPlayer.HdrType,dolbyvision)">DV</value>
		<value condition="String.Contains(VideoPlayer.HdrType,hlg)">HLG</value>
		<value>$VAR[Video_HDR_Codec]</value>
	</variable>
	
	
	
	
	
	
	
	
	
	
	
	<variable name="VS10_Button_DV_Label_Inside">
