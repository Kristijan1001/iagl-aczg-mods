		<value condition="Integer.IsEqual(Player.Process(amlogic.vs10.mode.raw),3) + [!String.IsEmpty(Player.Process(video.source.hdr.type)) + String.IsEqual(Player.Process(video.source.hdr.type),SDR) + String.Contains(Player.Process(amlogic.vs10.mode),SDR)]">➜ SDR</value>
	</variable>
