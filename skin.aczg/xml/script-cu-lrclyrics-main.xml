<?xml version="1.0" encoding="UTF-8"?>
<window>
	
	<zorder>0</zorder>
	
	<animation type="WindowOpen" reversible="false">
		<effect type="fade" time="750" />
	</animation>
	
	<animation type="WindowClose" reversible="false">
		<effect type="fade" time="375" />
	</animation>
	
	<depth>0.50</depth>
	
	<controls>
		
		
		
		<control type="image">
			<include>BackgroundDimensions</include>
			<aspectratio align="left" aligny="top">scale</aspectratio>
			<texture>special://home/addons/resource.images.aczg/resources/_added_img/noise00.jpg</texture>
			<animation effect="fade" end="25" time="0" condition="true">Conditional</animation>
		</control>
		
		
		
		<control type="image">
			<include>BackgroundDimensions</include>
			<texture>colors/black.png</texture>
			<animation effect="fade" end="25" time="0" condition="true">Conditional</animation>
		</control>
		
		
		
		<!-- ** Required ** Do not change <id> or <type> (Lyrics, will autoscroll if lrc based lyrics are shown) -->
		<control type="list" id="110">
			
			<left>310</left>
			<top>170</top>
			
			<width>1300</width>
			<height>600</height>
			
			<scrolltime>500</scrolltime>
			
			<itemlayout height="60">
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>1300</width>
					<height>60</height>
					<font>LyricsFonts</font>
					<aligny>center</aligny>
					<align>center</align>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			
			<focusedlayout height="60">
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>1300</width>
					<height>60</height>
					<font>LyricsFonts</font>
					<aligny>center</aligny>
					<align>center</align>
					<shadowcolor>black</shadowcolor>
					<textcolor>FF12B2E7</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
			
		</control>
		
		<control type="group">
			
			<control type="label">
				<description>Scraper label</description>
				<left>310</left>
				<top>80</top>
				<width>1300</width>
				<height>30</height>
				<label>$LOCALIZE[21870]: $INFO[Control.GetLabel(200)]</label>
				<font>Light17</font>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>FF999999</textcolor>
				<shadowcolor>black</shadowcolor>
				<visible>!String.IsEmpty(Control.GetLabel(200))</visible>
			</control>
			
			<!-- ** Required ** Do not change <id> or <type> (name of the used scraper and optionally the number of found lyrics) -->
			<control type="label" id="200">
				<description>Scraper label</description>
				<visible>false</visible>
			</control>
			
		</control>
		
		
		
	</controls>
</window>
