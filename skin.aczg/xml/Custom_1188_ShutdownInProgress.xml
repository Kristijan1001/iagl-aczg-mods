<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1188">
	
	<visible>!Skin.HasSetting(ShutdownScreenDisabled)   +   !String.IsEmpty(Window(Home).Property(CZ.ShutdownScreenActiveText))   +   !Window.IsVisible(YesNoDialog)</visible>
	
	<onload>AlarmClock(CZ.ShutdownScreenActiveCancelIfNotWorking,ClearProperty(CZ.ShutdownScreenActiveText,home),00:00:30,silent)</onload>
	<onunload>ClearProperty(CZ.ShutdownScreenActiveText,home)</onunload>
	
	<controls><!-- WRAPPER START --><control type="group"><include>WrapperDimensions</include><!-- WRAPPER START -->
		
		
		<control type="image">
			<include>BackgroundDimensions</include>
			<texture>colors/black.png</texture>
		</control>
		
		<control type="image">
			
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			
			<width>108</width>
			<height>108</height>
			<texture colordiffuse="$VAR[uiColorVariantKodiLogoColor]">_added_img/kodi-logo-large$VAR[isUhdScreenStringSuffix].png</texture>
			<aspectratio>keep</aspectratio>
		</control>
		
		
		
	<include condition="Skin.HasSetting(Enable_Debug_Overlay_Skin_And_Vars)">Debug_Overlay_Skin_And_Vars</include><include condition="Skin.HasSetting(Enable_Debug_Overlay_System_Load)">Debug_Overlay_System_Load</include><!-- WRAPPER STOP --></control><!-- WRAPPER STOP --></controls>
</window>
