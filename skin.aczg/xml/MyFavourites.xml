<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi 20+ MyFavourites.xml aka FavouritesBrowser -->
<window>
	<defaultcontrol always="true">450</defaultcontrol>
	<menucontrol>7000</menucontrol>
	<onload condition="!Skin.HasSetting(FirstTimeRun)">ActivateWindow(1112)</onload>
	<views>450</views>
	
	<controls><!-- WRAPPER START --><control type="group"><include>WrapperDimensions</include><!-- WRAPPER START -->
		
		<include>CommonBackground</include>
		<include>ContentPanelBackgrounds</include>
		
		<control type="group">
			
			<animation effect="slide" start="0,0" end="0,-30" time="0" condition="String.IsEqual(Skin.AspectRatio,16:10)">Conditional</animation>
			
			<left>246</left>
			<depth>DepthDialog+</depth>
			
			<include>Window_OpenClose_Animation</include>
			
			<control type="label">
				<left>21</left>
				<top>45</top>
				<width>1356</width>
				<height>45</height>
				<font>Light28</font>
				<textcolor>grey</textcolor>
				<align>center</align>
				<aligny>center</aligny>
				<label>$LOCALIZE[1036]</label>
			</control>
			
			<control type="group">
				
				<visible>Integer.IsGreater(Container(450).NumItems,0)</visible>
				
				<include>MyFavorites_Layout</include>
			</control>
			
		</control>
		
		<control type="group">
			
			<left>-429</left>
			
			<include>SideBladeLeft</include>
			
			<control type="grouplist" id="7000">
				<include>SideBladeLeftFadeInAni</include>
				<left>24</left>
				<top>90</top>
				<width>375</width>
				<height>975</height>
				
				<onleft>7000</onleft>
				<onright>450</onright>
				<onup>7000</onup>
				<ondown>7000</ondown>
				
				<onback>450</onback>
				
				<itemgap>0</itemgap>
				
				<control type="button" id="3">
					<description>Sort by button</description>
					<include>SideBar_Button_Common</include>
					<label>103</label>
				</control>
				<control type="togglebutton" id="4">
					<description>Sort asc</description>
					<include>SideBar_Button_Common</include>
					<alttexturefocus border="14" colordiffuse="$VAR[accentColorDiffuseForNeutralTextures]">button-focus-neutral.png</alttexturefocus>
					<alttexturenofocus></alttexturenofocus>
					<label>31051</label>
					<altlabel>31050</altlabel>
					<usealttexture>Container.SortDirection(Ascending)</usealttexture>
				</control>
				<control type="edit" id="19">
					<visible>Container.CanFilter + !Container.CanFilterAdvanced</visible>
					<description>Filter</description>
					<include>SideBar_Button_Common</include>
					<label>587</label>
				</control>
				<include>CommonNowPlaying_Controls</include>
			</control>
		</control>
		
		
		
		<include>FilterIndicator</include>
		
		
		
		<include>CommonNowPlaying_PIP</include>
		
		
		
		<include>BehindDialogFadeOut</include>
		
		
		
		<include condition="Integer.IsLess(Window(Home).Property(CinemaHelper.GetSettingValue.lookandfeel.skinzoom),0) | !String.IsEqual(Skin.AspectRatio,16:9)">SkinOutOfBoundsMasks</include>
		
		
		
	<include condition="Skin.HasSetting(Enable_Debug_Overlay_Skin_And_Vars)">Debug_Overlay_Skin_And_Vars</include><include condition="Skin.HasSetting(Enable_Debug_Overlay_System_Load)">Debug_Overlay_System_Load</include><!-- WRAPPER STOP --></control><!-- WRAPPER STOP --></controls>
</window>
