	<!-- Icon blurring is done via Cinema Helper except YouTube -->
	<!--
	YouTube icon blur fix
	Edge case: on some Linux or Amlogic builds (tbc), the original YouTube add-on PNG-8 icon causes a glitched blur image. Fixed by converting to PNG-24
	-->
	<onload condition="[String.IsEqual(ListItem.AddonName,YouTube) | String.IsEqual(Window(AddonSettings).Property(Addon.ID),plugin.video.youtube)] + System.HasAddon(service.listitem.helper)">RunScript(service.listitem.helper,action=blurimg,file='"special://skin/media/blur/yt_icon.png"',prop=addonsettings_art,radius=30)</onload>
	
	
	
	
	
	
	
