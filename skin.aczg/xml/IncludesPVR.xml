	<include name="PVR_SeekSlider_Kodi_18">
		
		<!-- Seek Slider Kodi 18+ LiveTV seek-->
		<control type="slider" id="403">
			<description>Seek Slider</description>
			<left>149</left>
			<top>10</top>
			<width>1424</width>
			<height>48</height>
			
			<texturesliderbar>osd/progress/seek_bg.png</texturesliderbar>
			<textureslidernib colordiffuse="$VAR[uiColorVariantSliderNibFocus]">osd/progress/seek_marker-neutral.png</textureslidernib>
			<textureslidernibfocus colordiffuse="$VAR[uiColorVariantSliderNibFocus]">osd/progress/seek_marker-neutral.png</textureslidernibfocus>
			
			<!-- Workaround: Reduce visual occurence of very short post seek slider jump (Kodi issue) -->
			<visible>!String.IsEmpty(Player.SeekTime) + !String.IsEqual(Player.SeekTime,Player.Time)</visible>
			
			<visible>[VideoPlayer.Content(LiveTV) + VideoPlayer.HasEpg]</visible>
			
			<visible>Player.Seeking + !String.IsEmpty(Player.SeekStepSize)</visible>
			
			<animation effect="slide" start="0,0" end="-3,0" time="0" condition="!String.IsEmpty(Player.SeekStepSize) + String.StartsWith(Player.SeekStepSize,-)" reversible="false">Conditional</animation>
			<animation effect="slide" start="0,0" end="3,0" time="0" condition="!String.IsEmpty(Player.SeekStepSize) + !String.StartsWith(Player.SeekStepSize,-)" reversible="false">Conditional</animation>
			
		</control>
		
	</include>
	
	<include name="PVR_SeekSlider_Kodi_19+">
		
		<!-- Seek Slider Kodi 18+ LiveTV seek-->
		<control type="slider"><info>PVR.TimeShiftSeekbar</info><!-- formely id="403" | PVR.TimeShiftSeekbar = Kodi 19+ -->
			<description>Seek Slider</description>
			<left>149</left>
			<top>10</top>
			<width>1424</width>
			<height>48</height>
			
			<texturesliderbar>osd/progress/seek_bg.png</texturesliderbar>
			<textureslidernib colordiffuse="$VAR[uiColorVariantSliderNibFocus]">osd/progress/seek_marker-neutral.png</textureslidernib>
			<textureslidernibfocus colordiffuse="$VAR[uiColorVariantSliderNibFocus]">osd/progress/seek_marker-neutral.png</textureslidernibfocus>
			
			<!-- Workaround: Reduce visual occurence of very short post seek slider jump (Kodi issue) -->
			<visible>!String.IsEmpty(Player.SeekTime) + !String.IsEqual(Player.SeekTime,Player.Time)</visible>
			
			<visible>[VideoPlayer.Content(LiveTV) + VideoPlayer.HasEpg]</visible>
			
			<visible>Player.Seeking + !String.IsEmpty(Player.SeekStepSize)</visible>
			
			<animation effect="slide" start="0,0" end="-3,0" time="0" condition="!String.IsEmpty(Player.SeekStepSize) + String.StartsWith(Player.SeekStepSize,-)" reversible="false">Conditional</animation>
			<animation effect="slide" start="0,0" end="3,0" time="0" condition="!String.IsEmpty(Player.SeekStepSize) + !String.StartsWith(Player.SeekStepSize,-)" reversible="false">Conditional</animation>
			
		</control>
		
